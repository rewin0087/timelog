<% m = @month_stats; today = Date.current; user = Current.user %>
<% pace = m.hours - @expected_hours %>
<section class="card">
  <div class="toolbar">
    <h2><%= today.strftime("%B %Y") %> progress <small><%= m.weekdays %> weekdays · <%= user.fixed_target? ? "#{fmt_hours(m.target)} target" : "no monthly target, up to #{fmt_hours(m.target)}" %></small></h2>
    <% if m.complete? %>
      <span class="badge badge-good">✓ Month complete</span>
    <% elsif pace.round(2) >= 0 %>
      <span class="badge badge-good">✓ On track</span>
    <% else %>
      <span class="badge badge-warn">! <%= fmt_hours(-pace) %> behind</span>
    <% end %>
  </div>

  <div class="kpis">
    <div class="kpi"><span class="kpi-label">Hours logged</span><span class="kpi-value"><%= fmt_hours(m.hours) %></span><span class="kpi-note"><%= m.percent %>% of <%= fmt_hours(m.target) %></span></div>
    <div class="kpi"><span class="kpi-label">Hours left to log</span><span class="kpi-value"><%= fmt_hours(m.remaining) %></span><span class="kpi-note"><%= pluralize(@weekdays_left, "weekday") %> left incl. today</span></div>
    <div class="kpi"><span class="kpi-label">Activities logged</span><span class="kpi-value"><%= m.entries %></span><span class="kpi-note">across <%= pluralize(m.days_logged, "day") %></span></div>
    <div class="kpi"><span class="kpi-label">Missed weekdays</span><span class="kpi-value"><%= @missed_days.size %></span><span class="kpi-note"><%= @missed_days.any? ? @missed_days.first(4).map { |d| d.strftime("%-d %b") }.join(", ") + ("…" if @missed_days.size > 4).to_s : "none so far" %></span></div>
  </div>

  <%= render "charts/meter", value: m.hours, total: m.target, marker: @expected_hours,
             marker_label: "#{fmt_hours(@expected_hours)} expected by today",
             label: "#{fmt_hours(m.hours)} of #{fmt_hours(m.target)} logged" %>

  <h3 class="chart-title">Hours per day</h3>
  <% share = user.daily_hours_for(today.beginning_of_month.next_weekday) %>
  <% bars = @month_days.map do |d|
       daily = user.daily_hours_for(d.date)
       name = d.date.strftime("%a, %-d %b")
       tone, value, tip =
         if d.weekend? && d.entries.zero? then [ "ghost", 0, "Weekend" ]
         elsif d.entries.positive? && d.holiday then [ holiday_tone(d.holiday), d.hours, "#{TimeStats.holiday_label(d.holiday)} · #{fmt_hours(d.hours)}" ]
         elsif d.entries.positive? then [ "accent", d.hours, "#{fmt_hours(d.hours)} · #{pluralize(d.entries, 'activity')}" ]
         elsif d.date < today then [ "missed", daily, "Missed · #{fmt_hours(daily)} not logged" ]
         else [ "ghost", daily, "#{fmt_hours(daily)} still to log" ]
         end
       { label: (d.date.day == 1 || (d.date.day % 5).zero? || d.date == today) ? d.date.day : "",
         aria: "#{name}: #{tip}", tip: safe_join([ tag.strong(name), tip ], tag.br),
         dim: d.weekend?, class: ("is-today" if d.date == today), series: [ { value: value, tone: tone } ] }
     end %>
  <%= render "charts/columns", bars: bars, dense: true, target: share, target_label: user.fixed_target? ? "Daily share (#{fmt_hours(share)})" : "#{fmt_hours(share)} per day",
             legend: [ [ "accent", "Logged" ], *@month_days.filter_map(&:holiday).uniq.map { |k| [ holiday_tone(k), TimeStats.holiday_label(k) ] },
                       [ "missed", "Missed" ], [ "ghost", "Still to log" ] ],
             title: "Hours logged per day in #{today.strftime('%B %Y')}" %>
</section>
