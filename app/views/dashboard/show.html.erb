<section class="card hero">
  <h2>Today's todo <small><%= Date.current.strftime("%A, %d %b %Y") %></small></h2>
  <%= form_with model: @new_entry, url: today_entry_path, class: "row" do |f| %>
    <%= f.text_field :todo, placeholder: "What are you working on today?", required: true, class: "grow" %>
    <%= f.submit "Log it" %>
  <% end %>
  <p class="muted"><%= hours_rule(Current.user) %></p>
  <%= render "time_entries/leave_hint" %>
</section>

<%= render "inspirations/frame" %>

<%= render "month_overview" %>
<%= render "history" %>

<div class="stats">
  <div class="stat"><div class="stat-label">Hours <%= @view == "month" ? "this month" : "this week" %></div><div class="stat-value"><%= number_with_precision(@total_hours, precision: 2) %>h</div></div>
  <div class="stat"><div class="stat-label">Todos logged</div><div class="stat-value"><%= @entries.size %></div></div>
  <div class="stat"><div class="stat-label">Days logged</div><div class="stat-value"><%= @by_day.size %></div></div>
</div>

<section class="card">
  <div class="toolbar">
    <h2><%= @title %></h2>
    <div class="toolbar-tabs">
      <div class="tabs">
        <%= link_to "Week", root_path(view: "week"), class: ("tab active" if @view == "week") || "tab" %>
        <%= link_to "Month report", root_path(view: "month"), class: ("tab active" if @view == "month") || "tab" %>
      </div>
      <div class="tabs" role="group" aria-label="Display">
        <% current = { view: @view, month: (params[:month] if @view == "month") }.compact %>
        <% [["table", "Table", "☰"], ["timeline", "Timeline", "⋮"]].each do |key, label, icon| %>
          <%= link_to root_path(current.merge(display: key)), class: ["tab", ("active" if @display == key)], aria: { pressed: @display == key } do %><span aria-hidden="true"><%= icon %></span> <%= label %><% end %>
        <% end %>
      </div>
    </div>
  </div>

  <% if @view == "month" %>
    <p class="muted pager">
      <%= link_to "← Previous", root_path(view: "month", month: @prev_month) %> ·
      <%= link_to "Next →", root_path(view: "month", month: @next_month) %>
    </p>
  <% end %>

  <% if @entries.empty? %>
    <p class="muted empty"><span class="empty-icon">🌱</span>No logs in this period.</p>
  <% elsif @display == "timeline" %>
    <%= render "timeline" %>
  <% else %>
    <table class="rtable">
      <thead><tr><th>Date</th><th>Todo</th><th class="num">Hours</th></tr></thead>
      <tbody>
        <% @by_day.each do |date, entries| %>
          <% entries.each_with_index do |e, i| %>
            <tr>
              <td class="<%= "cell-blank" unless i.zero? %>"><% if i.zero? %><span class="date-chip"><%= e.log_date.strftime("%a, %d %b") %></span><% end %></td>
              <td class="cell-main"><%= e.todo %></td>
              <td class="num" data-label="Hours"><%= number_with_precision(e.hours, precision: 2) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
      <tfoot><tr><td></td><td>Total</td><td class="num"><%= number_with_precision(@total_hours, precision: 2) %></td></tr></tfoot>
    </table>
  <% end %>
</section>
