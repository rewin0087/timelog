<%= form_with model: entry, class: "stack" do |f| %>
  <% if entry.errors.any? %>
    <p class="flash alert"><%= entry.errors.full_messages.to_sentence %></p>
  <% end %>
  <label>Date <%= f.date_field :log_date, required: true %></label>
  <label>Todo <%= f.text_area :todo, rows: 3, required: true %></label>
  <p class="muted">Hours are calculated automatically from the date:
    <% if Current.user.fixed_target? %><%= fmt_hours(Current.user.monthly_target) %> ÷ weekdays in that month = one day<% else %><%= User::DAILY_HOURS %>h per weekday<% end %>,
    shared by that day's todos; weekends get 0. Change this in your <%= link_to "profile", edit_profile_path %>.</p>
  <div class="form-actions"><%= f.submit %> <%= link_to "Cancel", time_entries_path, class: "btn btn-secondary" %></div>
<% end %>
