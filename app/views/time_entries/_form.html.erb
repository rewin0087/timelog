<%= form_with model: entry, class: "stack" do |f| %>
  <% if entry.errors.any? %>
    <p class="flash alert"><%= entry.errors.full_messages.to_sentence %></p>
  <% end %>
  <label>Date <%= f.date_field :log_date, required: true %></label>
  <label>Todo <%= f.text_area :todo, rows: 3, required: true %></label>
  <p class="muted">Hours are calculated automatically from the date (160h ÷ weekdays in that month = one day, shared by that day's todos; weekends get 0).</p>
  <div><%= f.submit %> <%= link_to "Cancel", time_entries_path %></div>
<% end %>
