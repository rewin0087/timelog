<!DOCTYPE html>
<html>
  <head>
    <title>Timelog</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body>
    <header class="nav">
      <strong>⏱ Timelog</strong>
      <% if authenticated? %>
        <nav>
          <%= link_to "Dashboard", root_path %>
          <%= link_to "Manage logs", time_entries_path %>
          <%= link_to "Export report", reports_path %>
          <%= link_to "Invoices", invoices_path %>
        </nav>
        <span class="who">
          <%= link_to Current.user.name, edit_profile_path %>
          <%= button_to "Sign out", session_path, method: :delete, class: "link" %>
        </span>
      <% end %>
    </header>
    <main>
      <% if notice %><p class="flash notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
