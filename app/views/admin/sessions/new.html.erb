<% content_for :title, "Sign in" %>
<%= render "shared/animated_bg" %>
<section class="card narrow auth landing-card admin-signin">
  <div class="landing-brand"><span class="brand-mark">⏱</span> <%= render "shared/wordmark" %> <span class="admin-pill">Admin</span></div>
  <h2>Back office</h2>
  <p class="muted">For administrators only. App accounts can't sign in here.</p>
  <%= form_with url: admin_session_path, class: "stack" do |f| %>
    <label>Email <%= f.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: flash[:email_address] %></label>
    <label>Password <%= f.password_field :password, required: true, autocomplete: "current-password", maxlength: 72 %></label>
    <div class="form-actions"><%= f.submit "Sign in to admin" %></div>
  <% end %>
</section>
