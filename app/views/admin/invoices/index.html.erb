<%= render "admin/users/header", user: @user %>
<section class="card">
  <h2>Generate invoice</h2>
  <% if @missing.any? %>
    <p class="flash alert">Can't generate yet. Missing: <%= @missing.to_sentence %>.</p>
  <% elsif can?(:create) %>
    <p class="muted">Exactly as <%= @user.name.split.first %> would from the app, with optional extra items and tax.</p>
    <%= render "invoices/generate_form", url: admin_user_invoices_path(@user), user: @user, periods: @periods, range: [ @range_from, @range_to, @range_due ] %>
  <% else %>
    <p class="muted">Your access level can't generate invoices.</p>
  <% end %>
</section>

<section class="card">
  <h2>Billed vs logged <small>last 12 months</small></h2>
  <% bars = @invoice_months.map do |m|
       { label: m[:month].strftime("%b"), sub: (m[:month].year if m[:month].month == 1 || m == @invoice_months.first),
         aria: "#{m[:month].strftime('%B %Y')}: #{fmt_hours(m[:billed_hours])} billed, #{fmt_hours(m[:logged_hours])} logged",
         tip: safe_join([ tag.strong(m[:month].strftime("%B %Y")), "#{fmt_hours(m[:billed_hours])} billed", "#{fmt_hours(m[:logged_hours])} logged",
                          (fmt_money(m[:currency], m[:amount]) if m[:invoices].positive?) ].compact, tag.br),
         series: [ { value: m[:billed_hours], tone: "accent" }, { value: m[:logged_hours], tone: "soft" } ] }
     end %>
  <%= render "charts/columns", bars: bars, legend: [ [ "accent", "Billed" ], [ "soft", "Logged" ] ], title: "Hours billed and logged per month" %>
</section>

<section class="card">
  <h2>Invoices <small><%= pluralize(@invoices.size, "invoice") %></small></h2>
  <% if @invoices.empty? %>
    <p class="muted empty"><span class="empty-icon">🧾</span>No invoices yet.</p>
  <% else %>
    <table class="rtable">
      <thead><tr><th>No.</th><th>Period</th><th>Date</th><th>Due</th><th class="num">Hours</th><th class="num">Amount</th><th></th></tr></thead>
      <tbody>
        <% @invoices.each do |i| %>
          <tr>
            <td class="cell-main"><%= i.code %></td>
            <td data-label="Period"><%= i.period_label %><% unless i.full_month? %> <span class="muted">(custom)</span><% end %><%= invoice_extras_note(i) %></td>
            <td data-label="Date"><%= i.invoice_date.strftime("%d %b %Y") %></td>
            <td data-label="Due"><%= i.due_date.strftime("%d %b %Y") %></td>
            <td class="num" data-label="Hours"><%= number_with_precision(i.hours, precision: 2) %></td>
            <td class="num" data-label="Amount"><%= fmt_money(i.currency, i.amount) %></td>
            <td class="actions">
              <%= button_tag "Preview", type: "button", class: "link", data: { action: "pdf-preview#open", pdf_preview_url_param: admin_user_invoice_path(@user, i), pdf_preview_title_param: "Invoice #{i.code} · #{@user.name}" } %>
              <%= link_to "PDF", admin_user_invoice_path(@user, i), data: { turbo: false } %>
              <% if can?(:destroy) %><%= button_to "Delete", admin_user_invoice_path(@user, i), method: :delete, class: "link danger", form: { data: { turbo_confirm: "Delete #{i.code}?" } } %><% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
