<div data-controller="reveal">
<%= render "charts" if @invoices.any? %>

<section class="card">
  <h2>Generate invoice</h2>
  <p class="muted">Dated the last day of the period and due on day <%= Current.user.invoice_due_day %> of the following month (change it in your <%= link_to "profile", edit_profile_path(anchor: "invoice-details") %>), or on the due date you pick for custom dates. <% if Current.user.fixed_target? %>A month always bills your fixed <%= fmt_hours(Current.user.monthly_target) %> at your hourly rate.<% else %>Bills the hours you logged (<%= User::DAILY_HOURS %>h per logged weekday) at your hourly rate.<% end %></p>
  <%= render "invoices/generate_form", url: invoices_path, user: Current.user, periods: @periods, range: [ @range_from, @range_to, @range_due ] %>
</section>

<section class="card">
  <h2>Invoices</h2>
  <% if @invoices.empty? %>
    <p class="muted empty"><span class="empty-icon">🧾</span>No invoices yet.</p>
  <% else %>
    <table class="rtable">
      <thead><tr><th>No.</th><th>Period</th><th>Date</th><th>Due</th><th class="num">Hours</th><th class="num">Amount <%= render "reveal_all" %></th><th></th></tr></thead>
      <tbody>
        <% @invoices.each do |i| %>
          <tr>
            <td class="cell-main"><%= i.code %></td>
            <td data-label="Period"><%= i.period_label %><% unless i.full_month? %> <span class="muted">(custom)</span><% end %><%= invoice_extras_note(i) %></td>
            <td data-label="Date"><%= i.invoice_date.strftime("%d %b %Y") %></td>
            <td data-label="Due"><%= i.due_date.strftime("%d %b %Y") %></td>
            <td class="num" data-label="Hours"><%= number_with_precision(i.hours, precision: 2) %></td>
            <td class="num" data-label="Amount">
              <span class="masked" data-reveal-target="item">
                <span class="masked-value"><%= i.currency %> <%= number_with_delimiter(number_with_precision(i.amount, precision: 2)) %></span>
                <span class="masked-dots" aria-hidden="true"><%= i.currency %> ••••••</span>
                <button type="button" class="reveal-btn" data-action="reveal#toggle" aria-pressed="false" aria-label="Show amount"><svg class="eye-open" viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg><svg class="eye-shut" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 5.1A10.8 10.8 0 0 1 12 5c6.5 0 10 7 10 7a17 17 0 0 1-3.2 4.1M6.6 6.6A17 17 0 0 0 2 12s3.5 7 10 7a10 10 0 0 0 5.4-1.6"/><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/></svg></button>
              </span>
            </td>
            <td class="actions">
              <%= button_tag "Preview", type: "button", class: "link",
                    data: { action: "pdf-preview#open", pdf_preview_url_param: invoice_path(i), pdf_preview_title_param: "Invoice #{i.code}" } %>
              <%= link_to "Download PDF", invoice_path(i), data: { turbo: false } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
</div>
