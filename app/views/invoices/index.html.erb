<section class="card">
  <h2>Generate invoice</h2>
  <% if @missing.any? %>
    <p class="flash alert">Complete your <%= link_to "profile", edit_profile_path %> before generating: <%= @missing.to_sentence %>.</p>
  <% end %>
  <p class="muted">Dated the last day of the month, due on day <%= Current.user.invoice_due_day %> of the following month (change it in your <%= link_to "profile", edit_profile_path %>). Always bills a fixed 160 hours at your hourly rate, regardless of what is logged. Generating again for the same month refreshes it.</p>
  <%= form_with url: invoices_path, class: "row" do |f| %>
    <%= select_tag :period, options_for_select(@periods.map { |d| [d.strftime("%B %Y"), d.strftime("%Y-%m")] }, @default_period.strftime("%Y-%m")) %>
    <%= f.submit "Generate invoice" %>
  <% end %>
</section>

<section class="card">
  <h2>Generate invoice for custom dates</h2>
  <p class="muted">Bills part of a month: the 160 monthly hours are prorated by the weekdays in the range (e.g. 11 of 22 weekdays = 80 hours). Both dates must be in the same month and must not overlap an existing invoice. Dated the end date and due on the due date you pick, which can't be earlier than the end date. Generating again for the same dates refreshes it.</p>
  <%= form_with url: invoices_path, class: "row" do |f| %>
    <label>From <%= date_field_tag :from, @range_from, required: true %></label>
    <label>To <%= date_field_tag :to, @range_to, required: true %></label>
    <label>Due <%= date_field_tag :due_date, @range_due, required: true %></label>
    <%= f.submit "Generate custom invoice" %>
  <% end %>
</section>

<section class="card">
  <h2>Invoices</h2>
  <% if @invoices.empty? %>
    <p class="muted empty"><span class="empty-icon">🧾</span>No invoices yet.</p>
  <% else %>
    <table class="rtable">
      <thead><tr><th>No.</th><th>Period</th><th>Date</th><th>Due</th><th class="num">Hours</th><th class="num">Amount</th><th></th></tr></thead>
      <tbody>
        <% @invoices.each do |i| %>
          <tr>
            <td class="cell-main"><%= i.code %></td>
            <td data-label="Period"><%= i.period_label %><% unless i.full_month? %> <span class="muted">(custom)</span><% end %></td>
            <td data-label="Date"><%= i.invoice_date.strftime("%d %b %Y") %></td>
            <td data-label="Due"><%= i.due_date.strftime("%d %b %Y") %></td>
            <td class="num" data-label="Hours"><%= number_with_precision(i.hours, precision: 2) %></td>
            <td class="num" data-label="Amount"><%= i.currency %> <%= number_with_delimiter(number_with_precision(i.amount, precision: 2)) %></td>
            <td class="actions">
              <%= button_tag "Preview", type: "button", class: "link",
                    data: { action: "pdf-preview#open", pdf_preview_url_param: invoice_path(i), pdf_preview_title_param: "Invoice #{i.code}" } %>
              <%= link_to "Download PDF", invoice_path(i), data: { turbo: false } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</section>
