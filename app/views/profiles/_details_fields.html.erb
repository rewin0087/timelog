<%# Invoice details and working hours, shared by the profile and onboarding. Fields marked required are needed to generate invoices. %>
<label>Full name <%= f.text_field :name, required: true %></label>
<label>Address <%= f.text_area :address, rows: 2, required: true %></label>
<h3>Bill to</h3>
<label>Client name <%= f.text_field :bill_to_name, required: true, placeholder: "Company you invoice" %></label>
<label>Client address <%= f.text_area :bill_to_address, rows: 3, required: true, placeholder: "One line per row, as it should appear on the invoice" %></label>
<h3>Invoice line</h3>
<label>Item (shown on the invoice line) <%= f.text_field :invoice_item, required: true, maxlength: 40, placeholder: User::DEFAULT_INVOICE_ITEM %></label>
<label>Hourly rate <%= f.number_field :hourly_rate, step: 0.01, min: 0.01, required: true %></label>
<label>Currency (ISO code) <%= f.text_field :currency, maxlength: 3, required: true %></label>
<label>Invoice due day (day of the following month) <%= f.number_field :invoice_due_day, min: 1, max: 31, step: 1, required: true %></label>
<h3>Working hours</h3>
<fieldset class="hours-settings">
  <legend class="sr-only">How hours are worked out</legend>
  <label class="choice">
    <%= f.radio_button :hours_mode, "monthly" %>
    <span><strong>Fixed monthly target</strong><small>The target is spread over the month's weekdays (160h ÷ 21 weekdays = 7.62h a day) and invoices bill the full target.</small></span>
  </label>
  <label class="monthly-field">Monthly target hours (leave blank for <%= User::DEFAULT_MONTHLY_HOURS %>)
    <%= f.number_field :monthly_hours, step: 0.01, min: 1, max: 744, placeholder: User::DEFAULT_MONTHLY_HOURS %>
  </label>
  <label class="choice">
    <%= f.radio_button :hours_mode, "daily" %>
    <span><strong>No monthly target</strong><small>Each logged weekday counts <%= User::DAILY_HOURS %>h (the daily cap), with no monthly limit. Invoices bill the hours you logged.</small></span>
  </label>
  <% if f.object.time_entries.exists? %>
    <p class="muted">Changing this recalculates the hours on all your existing logs. Invoices you already generated keep their hours until you generate them again.</p>
  <% end %>
</fieldset>
<h3>Bank details</h3>
<label>Account name <%= f.text_field :bank_account_name, required: true %></label>
<label>Account number <%= f.text_field :bank_account_number, required: true %></label>
<label>Bank name <%= f.text_field :bank_name, required: true %></label>
<label>SWIFT <%= f.text_field :bank_swift, required: true %></label>
