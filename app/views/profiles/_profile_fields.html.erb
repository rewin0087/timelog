<%# Name, own address (printed at the top of invoices) and working hours. Used on the profile and in onboarding. %>
<label>Full name <%= f.text_field :name, required: true %></label>
<label>Address <%= f.text_area :address, rows: 2, required: true %></label>
<h3>Working hours</h3>
<fieldset class="hours-settings">
  <legend class="sr-only">How hours are worked out</legend>
  <label class="choice">
    <%= f.radio_button :hours_mode, "monthly" %>
    <span><strong>Fixed monthly target</strong><small>The target is spread over the month's weekdays (160h ÷ 21 weekdays = 7.62h a day) and invoices bill the full target.</small></span>
  </label>
  <label class="monthly-field">Monthly target hours (leave blank for <%= User::DEFAULT_MONTHLY_HOURS %>)
    <%= f.number_field :monthly_hours, step: 0.01, min: 1, max: 744, placeholder: User::DEFAULT_MONTHLY_HOURS %>
  </label>
  <label class="choice">
    <%= f.radio_button :hours_mode, "daily" %>
    <span><strong>No monthly target</strong><small>Each logged weekday counts <%= User::DAILY_HOURS %>h (the daily cap), with no monthly limit. Invoices bill the hours you logged.</small></span>
  </label>
  <% if f.object.time_entries.exists? %>
    <p class="muted">Changing this recalculates the hours on all your existing logs. Invoices you already generated keep their hours until you generate them again.</p>
  <% end %>
</fieldset>
