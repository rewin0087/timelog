<section class="card" id="profile">
  <h2>Profile</h2>
  <p class="muted">Your name and address appear at the top of your invoices. Signed in as <%= @user.email_address %>.</p>
  <%= form_with model: @user, url: profile_path, method: :patch, class: "stack" do |f| %>
    <%= hidden_field_tag :section, "profile" %>
    <% if @user.errors.any? %><p class="flash alert"><%= @user.errors.full_messages.to_sentence %></p><% end %>
    <%= render "profiles/profile_fields", f: %>
    <div class="form-actions"><%= f.submit "Save profile" %></div>
  <% end %>
</section>

<section class="card" id="invoice-details">
  <h2>Invoice details</h2>
  <p class="muted">Who you bill, what the invoice line says, and where you get paid. All fields are required to generate invoices.</p>
  <%= form_with model: @invoice_user, url: profile_path, method: :patch, class: "stack" do |f| %>
    <%= hidden_field_tag :section, "invoice" %>
    <% if @invoice_user.errors.any? %><p class="flash alert"><%= @invoice_user.errors.full_messages.to_sentence %></p><% end %>
    <%= render "profiles/invoice_fields", f: %>
    <h3>PDF style defaults</h3>
    <p class="muted">Used unless you pick another design or colour when exporting a report or generating an invoice.</p>
    <div class="pdf-defaults">
      <div><strong>Timesheet report</strong><%= render "shared/pdf_style_fields", kind: :report, style: @invoice_user.report_style, design_name: "user[report_design]", color_name: "user[report_color]" %></div>
      <div><strong>Invoice</strong><%= render "shared/pdf_style_fields", kind: :invoice, style: @invoice_user.invoice_style, design_name: "user[invoice_design]", color_name: "user[invoice_color]" %></div>
    </div>
    <div class="form-actions"><%= f.submit "Save invoice details" %></div>
  <% end %>
</section>

<section class="card" id="lock-screen">
  <div class="lock-settings-head">
    <span class="lock-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></span>
    <h2>Lock screen</h2>
  </div>
  <p class="muted">
    <% saved = @lock_user.auto_lock_minutes_in_database %>
    <% if saved.positive? %>Locks automatically after <strong><%= User::AUTO_LOCK_OPTIONS.key(saved) %></strong> of inactivity.<% else %>Auto-lock is <strong>off</strong>.<% end %>
    The lock screen is always on; change your code or the auto-lock period below.
  </p>
  <%= form_with model: @lock_user, url: lock_settings_path, method: :patch, class: "stack" do |f| %>
    <% if @lock_user.errors.any? %><p class="flash alert"><%= @lock_user.errors.full_messages.to_sentence %></p><% end %>
    <%= render "lock_settings/fields", f:, setup: false %>
    <div class="form-actions"><%= f.submit "Save lock settings" %></div>
  <% end %>
</section>

<section class="card" id="password">
  <div class="lock-settings-head">
    <span class="lock-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M11 12l8-8M16 7l2 2M18 5l2 2"/></svg></span>
    <h2>Password</h2>
  </div>
  <p class="muted">Changing your password signs you out on every other device.</p>
  <%= form_with model: @password_user, url: password_path, method: :patch, class: "stack" do |f| %>
    <% if @password_user.errors.any? %><p class="flash alert"><%= @password_user.errors.full_messages.to_sentence %></p><% end %>
    <label>Current password <%= password_field_tag :current_password, nil, required: true, autocomplete: "current-password" %></label>
    <label>New password (min 8 characters) <%= f.password_field :password, required: true, minlength: 8, maxlength: 72, autocomplete: "new-password" %></label>
    <label>Confirm new password <%= f.password_field :password_confirmation, required: true, maxlength: 72, autocomplete: "new-password" %></label>
    <div class="form-actions"><%= f.submit "Update password" %></div>
  <% end %>
</section>
