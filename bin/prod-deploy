#!/usr/bin/env bash
# Ships the current working tree to the local production app at http://time.log.
#
# Production runs from a copy outside ~/Documents (launchd agents are blocked from
# reading ~/Documents by macOS privacy protection). This copies the code there,
# installs gems, migrates the production DB, rebuilds assets and restarts puma.
set -euo pipefail
SRC="$(cd "$(dirname "$0")/.." && pwd)"
DEST="${TIMELOG_PROD_DIR:-$HOME/apps/timelog}"
LABEL="log.time.puma"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"

export PATH="$HOME/.rbenv/shims:/opt/homebrew/bin:/usr/local/bin:$PATH"

mkdir -p "$DEST"
rsync -a --delete \
  --exclude .git/ --exclude /log/ --exclude /tmp/ --exclude /storage/ \
  --exclude /public/assets/ --exclude /coverage/ --exclude /spec/ \
  "$SRC/" "$DEST/"

cd "$DEST"
mkdir -p log tmp/pids
set -a
[ -f .env ] && . ./.env
. ./.env.production
set +a

bundle install --quiet
bin/rails db:migrate
bin/rails assets:clobber assets:precompile >/dev/null

if launchctl print "gui/$(id -u)/$LABEL" >/dev/null 2>&1; then
  launchctl kickstart -k "gui/$(id -u)/$LABEL"
else
  launchctl bootstrap "gui/$(id -u)" "$PLIST"
fi
echo "Deployed $SRC -> $DEST. http://time.log"
